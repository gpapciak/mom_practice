#!/bin/sh
#
# Blocks a commit that would publish personal, clinical or locating content.
#
# This hook exists because running the check manually failed twice, in the same way
# both times: the scan was chained after some other command, its non-zero exit was
# swallowed, and the commit proceeded. Writing down the rule "run it separately and
# read the result" did not prevent the second occurrence.
#
# So it is no longer a matter of remembering. The check runs here, and a non-zero
# exit stops the commit.
#
# Enabled by:  git config core.hooksPath .githooks
# Bypassed by: git commit --no-verify   (which should essentially never be right)

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found; cannot run the content gate." >&2
  exit 1
fi

if ! node tests/check_no_personal.mjs; then
  echo "" >&2
  echo "pre-commit: BLOCKED. The lines above must not be published." >&2
  echo "Rewrite them generically, or move the file to the private repository." >&2
  exit 1
fi

# The test suites run here too, for the same reason: a suite that is only run when
# someone remembers is a suite that passes on the commits nobody checked.
for suite in tests/test_shell.mjs tests/test_pool.mjs tests/test_upload.mjs; do
  if ! node "$suite" >/tmp/suite.$$ 2>&1; then
    tail -30 /tmp/suite.$$ >&2
    rm -f /tmp/suite.$$
    echo "" >&2
    echo "pre-commit: BLOCKED. $suite is failing." >&2
    exit 1
  fi
  rm -f /tmp/suite.$$
done
